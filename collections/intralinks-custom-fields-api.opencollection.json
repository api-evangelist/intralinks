{
  "opencollection": "1.0.0",
  "info": {
    "name": "Intralinks Authentication Custom Fields API",
    "version": "2.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Custom Fields",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Intralinks List Custom Fields",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.intralinks.com/v2/workspaces/:workspaceId/customfields",
            "params": [
              {
                "name": "workspaceId",
                "value": "",
                "type": "path",
                "description": "The unique identifier of the workspace."
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Returns custom field definitions for a workspace."
        }
      ]
    }
  ],
  "bundled": true
}